---
import Logotipo from "@images/logotipo.webp";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale === "en" ? "en" : "es";
const isEnglish = locale === "en";
const route = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "").replace(/^\//, "");
const section = route.startsWith("music") ? "music" : route.startsWith("languages") ? "languages" : "home";
const seoCopy = {
  es: {
    home: ["Americana Academy - Educación online moderna", "Impulsa tu desarrollo personal y profesional con clases dinámicas y personalizadas de idiomas y música."],
    music: ["Clases de música online | Americana Academy", "Aprende piano, guitarra, violín, batería, canto y más con clases personalizadas y profesores especializados."],
    languages: ["Clases de inglés conversacional online | Americana Academy", "Aprende inglés con clases conversacionales dinámicas y personalizadas, un enfoque práctico y profesores expertos."],
    keywords: "clases online, academia de inglés, inglés conversacional, clases de música, aprendizaje personalizado",
  },
  en: {
    home: ["Americana Academy | Modern Online Education", "Advance your personal and professional growth through dynamic, personalized language and music classes."],
    music: ["Online Music Lessons | Americana Academy", "Learn piano, guitar, violin, drums, voice, and more through personalized lessons with expert instructors."],
    languages: ["Online Conversational English Classes | Americana Academy", "Learn English through dynamic, personalized conversation classes, practical instruction, and expert teachers."],
    keywords: "online classes, English academy, conversational English, music lessons, personalized learning",
  },
} as const;
const copy = seoCopy[locale];
const [pageTitle, pageDescription] = copy[section];

// SEO Configuration
const siteConfig = {
  title: pageTitle,
  description: pageDescription,
  canonical: Astro.url.href,
  siteName: "Americana Academy",
  locale: isEnglish ? "en_US" : "es_CO",
  type: "website"
};

const openGraph = {
  title: pageTitle,
  description: pageDescription,
  image: Logotipo.src,
  url: Astro.url.href
};

const organizationSchema = {
  "@context": "https://schema.org", "@type": "EducationalOrganization", name: "Americana Academy",
  description: pageDescription, url: Astro.url.origin, logo: `${Astro.url.origin}${Logotipo.src}`, foundingDate: "2018",
  address: { "@type": "PostalAddress", addressCountry: "CO" },
  contactPoint: { "@type": "ContactPoint", contactType: "customer service", availableLanguage: ["Spanish", "English"] },
};

const twitter = {
  card: "summary_large_image",
  title: siteConfig.title,
  description: siteConfig.description,
  image: Logotipo.src
};
---

<head>
  <!-- Essential Meta Tags -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- SEO Meta Tags -->
  <title>{siteConfig.title}</title>
  <meta name="description" content={siteConfig.description} />
  <meta name="keywords" content={copy.keywords} />
  <meta name="author" content="Americana Academy" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={siteConfig.canonical} />
  <link rel="alternate" hreflang="es" href={getRelativeLocaleUrl("es", route)} />
  <link rel="alternate" hreflang="en" href={getRelativeLocaleUrl("en", route)} />
  <link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl("es", route)} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={siteConfig.type} />
  <meta property="og:url" content={openGraph.url} />
  <meta property="og:title" content={openGraph.title} />
  <meta property="og:description" content={openGraph.description} />
  <meta property="og:image" content={openGraph.image} />
  <meta property="og:site_name" content={siteConfig.siteName} />
  <meta property="og:locale" content={siteConfig.locale} />
  <meta property="og:locale:alternate" content={isEnglish ? "es_CO" : "en_US"} />
  
  <!-- Twitter -->
  <meta property="twitter:card" content={twitter.card} />
  <meta property="twitter:url" content={openGraph.url} />
  <meta property="twitter:title" content={twitter.title} />
  <meta property="twitter:description" content={twitter.description} />
  <meta property="twitter:image" content={twitter.image} />
  
  <!-- Additional SEO -->
  <meta name="theme-color" content="#FF6363" />
  <meta name="msapplication-TileColor" content="#FF6363" />
  
  <!-- Business/Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet"
    media="print" 
    onload="this.media='all'"
  />
  <link
    rel="preload"
    as="image"
    href={Logotipo.src}
    type="image/webp"
  />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
</head>
