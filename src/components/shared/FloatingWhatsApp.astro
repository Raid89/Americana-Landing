---
const isEnglish = Astro.currentLocale === "en";
const label = isEnglish ? "Chat with us on WhatsApp" : "Escríbenos por WhatsApp";
---

<a
  class="whatsapp-float"
  href="https://wa.me/573217631101"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
>
  <span class="whatsapp-tooltip" aria-hidden="true">{label}</span>
  <svg
    aria-hidden="true"
    viewBox="0 0 32 32"
    width="32"
    height="32"
    fill="currentColor"
  >
    <path d="M16.04 3A12.85 12.85 0 0 0 5.13 22.64L3.31 29l6.52-1.71A12.9 12.9 0 1 0 16.04 3Zm0 23.58c-1.9 0-3.76-.51-5.38-1.48l-.39-.23-3.87 1.02 1.03-3.77-.25-.39a10.63 10.63 0 1 1 8.86 4.85Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59a9.58 9.58 0 0 1-1.78-2.22c-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.22.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65s1.14 3.07 1.3 3.28c.16.21 2.24 3.42 5.42 4.79.76.32 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.89-.77 2.15-1.52.27-.74.27-1.38.19-1.51-.08-.14-.29-.22-.61-.38Z" />
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 28px;
    bottom: 28px;
    z-index: 1000;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    color: #fff;
    background: linear-gradient(135deg, #2bd66f, #20b85a);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    box-shadow: 0 8px 24px rgba(20, 123, 64, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    animation: whatsapp-pulse 2.8s ease-in-out infinite;
  }

  .whatsapp-float:hover {
    color: #fff;
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 12px 30px rgba(20, 123, 64, 0.45);
    animation-play-state: paused;
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid #212529;
    outline-offset: 4px;
  }

  .whatsapp-tooltip {
    position: absolute;
    right: calc(100% + 12px);
    width: max-content;
    padding: 9px 13px;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    background: #212529;
    border-radius: 9px;
    box-shadow: 0 6px 18px rgba(33, 37, 41, 0.2);
    opacity: 0;
    pointer-events: none;
    transform: translateX(8px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .whatsapp-float:hover .whatsapp-tooltip,
  .whatsapp-float:focus-visible .whatsapp-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes whatsapp-pulse {
    0%, 100% { box-shadow: 0 8px 24px rgba(20, 123, 64, 0.35); }
    50% { box-shadow: 0 8px 24px rgba(20, 123, 64, 0.35), 0 0 0 10px rgba(43, 214, 111, 0); }
  }

  @media screen and (max-width: 700px) {
    .whatsapp-float {
      right: 18px;
      bottom: 18px;
      width: 54px;
      height: 54px;
    }

    .whatsapp-float svg {
      width: 29px;
      height: 29px;
    }

    .whatsapp-tooltip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      animation: none;
      transition: none;
    }
  }
</style>
