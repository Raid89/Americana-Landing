---
import { useTranslations } from "../../i18n";
import { getEnglishBenefits } from "../../i18n/content";
const { locale, t } = useTranslations(Astro.currentLocale);
const englishBenefits = getEnglishBenefits(locale);
---

<section id="english-benefits" class="english-benefits" data-animate="benefits">
  <div class="benefits-header" data-grid="header">
    <h2>{t("englishBenefits.heading")}</h2>
    <p>{t("englishBenefits.intro")}</p>
    <div class="global-stat">
      <span class="stat-icon">🌐</span>
      <p><strong>{t("englishBenefits.global")}</strong> {t("englishBenefits.globalText")}</p>
    </div>
  </div>

  <div class="benefits-grid">
    {englishBenefits.map((benefit, index) => (
      <div 
        class="benefit-card" 
        data-benefit="card"
        style={`--accent-color: ${benefit.color}`}
      >
        <div class="benefit-header">
          <div class="benefit-icon">
            <span>{benefit.icon}</span>
          </div>
          <h3>{benefit.title}</h3>
        </div>
        
        <p class="benefit-description">{benefit.description}</p>
        
        <div class="benefit-stat">
          <span class="stat-indicator">📊</span>
          <span class="stat-text">{benefit.stats}</span>
        </div>
        
        <div class="benefit-gradient"></div>
      </div>
    ))}
  </div>

  <div class="benefits-cta" data-animate="fade-up">
    <div class="cta-container" data-grid="cta">
      <div class="cta-content">
        <span class="cta-icon">🚀</span>
        <div class="cta-text">
          <h3>{t("englishBenefits.ctaTitle")}</h3>
          <p>{t("englishBenefits.ctaText")}</p>
        </div>
      </div>
      
      <div class="cta-actions">
        <a href="#contactSection" class="cta-primary">
          <span>🎯</span>
          {t("englishBenefits.start")}
        </a>
        <a href="#english-levels" class="cta-secondary">
          <span>📋</span>
          {t("englishBenefits.viewLevels")}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @import "@styles/animations.css";

  .english-benefits {
    padding: 120px 100px;
    background: linear-gradient(180deg, #F0F8FF 0%, #FDFBFA 50%, #F0F8FF 100%);
    position: relative;
    overflow: hidden;
  }

  .english-benefits::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="15" cy="15" r="1" fill="%234A90E2" opacity="0.1"/><circle cx="85" cy="25" r="1.5" fill="%23FF6363" opacity="0.1"/><circle cx="25" cy="75" r="1.2" fill="%2366FFB2" opacity="0.1"/><circle cx="75" cy="85" r="0.8" fill="%23FFB366" opacity="0.1"/></svg>') repeat;
    pointer-events: none;
  }

  .benefits-header {
    text-align: center;
    margin-bottom: 80px;
    position: relative;
    z-index: 1;

    h2 {
      font-size: 64px;
      font-weight: 600;
      margin: 0 0 20px 0;
      background: linear-gradient(135deg, #212529, #4A90E2, #FF6363);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    p {
      font-size: 20px;
      color: #666;
      margin: 0 0 30px 0;
      font-weight: 500;
    }
  }

  .global-stat {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(74, 144, 226, 0.1);
    color: #4A90E2;
    padding: 15px 25px;
    border-radius: 30px;
    border: 2px solid rgba(74, 144, 226, 0.2);
    font-weight: 600;

    .stat-icon {
      font-size: 20px;
    }

    p {
      margin: 0;
      font-size: 16px;
    }
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 30px;
    margin-bottom: 80px;
    position: relative;
    z-index: 1;
  }

  .benefit-card {
    background: white;
    border-radius: 25px;
    padding: 35px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    animation-delay: var(--delay);
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--accent-color);
  }

  .benefit-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12);
    border-color: var(--accent-color);
  }

  .benefit-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .benefit-icon {
    width: 70px;
    height: 70px;
    background: var(--accent-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;

    span {
      font-size: 35px;
      filter: brightness(1.2);
    }
  }

  .benefit-card:hover .benefit-icon {
    transform: scale(1.1) rotate(5deg);
  }

  .benefit-header h3 {
    font-size: 24px;
    font-weight: 600;
    margin: 0;
    color: #212529;
    flex: 1;
  }

  .benefit-description {
    font-size: 16px;
    line-height: 26px;
    color: #666;
    margin-bottom: 25px;
  }

  .benefit-stat {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(74, 144, 226, 0.05);
    padding: 12px 18px;
    border-radius: 15px;
    border: 1px solid rgba(74, 144, 226, 0.1);

    .stat-indicator {
      font-size: 16px;
    }

    .stat-text {
      font-size: 14px;
      font-weight: 600;
      color: var(--accent-color);
    }
  }

  .benefit-gradient {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, var(--accent-color) 0%, transparent 70%);
    opacity: 0.1;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .benefit-card:hover .benefit-gradient {
    transform: scale(1.3);
    opacity: 0.15;
  }

  .benefits-cta {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .cta-container {
    background: linear-gradient(135deg, #4A90E2, #66B2FF);
    color: white;
    padding: 50px;
    border-radius: 30px;
    box-shadow: 0 20px 40px rgba(74, 144, 226, 0.2);
    position: relative;
    overflow: hidden;
  }

  .cta-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="40" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="60" cy="70" r="2.5" fill="rgba(255,255,255,0.1)"/></svg>') repeat;
    pointer-events: none;
  }

  .cta-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 30px;
    position: relative;
    z-index: 1;

    .cta-icon {
      font-size: 50px;
    }

    .cta-text {
      text-align: left;

      h3 {
        font-size: 32px;
        font-weight: 600;
        margin: 0 0 10px 0;
      }

      p {
        font-size: 18px;
        margin: 0;
        opacity: 0.95;
      }
    }
  }

  .cta-actions {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
    align-items: center;
    margin-top: 30px;
  }

  .cta-primary, .cta-secondary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 30px;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    white-space: nowrap;
    min-width: fit-content;
    flex-shrink: 0;
  }

  .cta-primary {
    background: white;
    color: #4A90E2;
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.3);
  }

  .cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.4);
  }

  .cta-secondary {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  .cta-secondary:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media screen and (max-width: 1600px) {
    .english-benefits {
      padding: 100px 60px;
    }

    .benefits-grid {
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 25px;
    }
  }

  @media screen and (max-width: 1300px) {
    .english-benefits {
      padding: 80px 40px;
    }

    .benefits-header h2 {
      font-size: 48px;
    }

    .benefits-grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .benefit-card {
      padding: 30px;
    }

    .cta-content {
      flex-direction: column;
      text-align: center;
    }

    .cta-text {
      text-align: center !important;
    }
  }

  @media screen and (max-width: 900px) {
    .english-benefits {
      padding: 60px 30px;
    }

    .benefits-header h2 {
      font-size: 36px;
    }

    .benefits-header p {
      font-size: 18px;
    }

    .benefits-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  @media screen and (max-width: 900px) {
    .english-benefits {
      padding: 60px 30px;
    }

    .benefits-header h2 {
      font-size: 36px;
    }

    .benefits-header p {
      font-size: 18px;
    }

    .benefits-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .cta-actions {
      gap: 15px;
    }

    .cta-primary, .cta-secondary {
      padding: 14px 25px;
      font-size: 15px;
    }
  }

  @media screen and (max-width: 768px) {
    .english-benefits {
      padding: 60px 20px;
    }

    .benefits-header h2 {
      font-size: 32px;
    }

    .benefits-header p {
      font-size: 16px;
    }

    .global-stat {
      padding: 12px 20px;
      
      .stat-icon {
        font-size: 18px;
      }
      
      p {
        font-size: 14px;
      }
    }

    .benefits-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .benefit-card {
      padding: 25px;
    }

    .benefit-header {
      gap: 15px;
    }

    .benefit-icon {
      width: 60px;
      height: 60px;
      
      span {
        font-size: 30px;
      }
    }

    .benefit-header h3 {
      font-size: 20px;
    }

    .benefit-description {
      font-size: 15px;
    }

    .cta-container {
      padding: 30px 25px !important;
    }

    .cta-content .cta-text h3 {
      font-size: 24px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .cta-primary, .cta-secondary {
      width: 100% !important;
      max-width: 280px !important;
      justify-content: center !important;
      flex-shrink: 0;
    }
  }

  @media screen and (max-width: 480px) {
    .english-benefits {
      padding: 40px 15px;
    }

    .benefits-header h2 {
      font-size: 28px;
    }

    .global-stat {
      padding: 10px 16px;
      
      p {
        font-size: 12px;
      }
    }

    .benefit-card {
      padding: 20px;
    }

    .benefit-header {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }

    .benefit-icon {
      width: 50px;
      height: 50px;
      margin: 0 auto;
      
      span {
        font-size: 25px;
      }
    }

    .cta-container {
      padding: 25px 20px !important;
    }

    .cta-content .cta-icon {
      font-size: 40px;
    }

    .cta-content .cta-text h3 {
      font-size: 20px;
    }

    .cta-content .cta-text p {
      font-size: 14px;
    }

    .cta-actions {
      gap: 10px;
    }

    .cta-primary, .cta-secondary {
      width: 100% !important;
      max-width: 260px !important;
      padding: 12px 20px !important;
      font-size: 14px !important;
    }
  }
</style>
