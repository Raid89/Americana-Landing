---
import ButtonContact from "@components/shared/ButtonContact.astro";
import { useTranslations } from "../../i18n";

const { title, description } = Astro.props;
const { t } = useTranslations(Astro.currentLocale);

---

<section id="hero" class="hero" data-animate="hero">
  <div class="hero-content" data-hero="bg">
    <div class="hero-text" data-hero="text">
      <div class="academy-badge">
        <span class="academy-icon">🎓</span>
        <span class="text">{t("hero.badge")}</span>
      </div>
      <h1 data-hero="title">{title}</h1>
      <ul class="hero-description" data-hero="subtitle" set:html={description} />
      <div class="academy-highlight">
        <span class="academy-icon">✨</span>
        <p>{t("hero.highlight")}</p>
      </div>
      <div class="cta" data-hero="cta">
        <ButtonContact
          href="#contactSection"
          text={t("nav.contact")}
          className="academy-cta"
        />
      </div>
      <div class="academy-proof">
        <span>🏆</span>
        <p>{t("hero.years")}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #FDFBFA 0%, #F8F6F5 100%);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="2" fill="%23FF6363" opacity="0.1"/><circle cx="80" cy="40" r="1.5" fill="%23FF6363" opacity="0.1"/><circle cx="60" cy="70" r="2.5" fill="%23FF6363" opacity="0.1"/><circle cx="30" cy="80" r="1" fill="%23FF6363" opacity="0.1"/></svg>') repeat;
    pointer-events: none;
  }

  .hero-content {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 560px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 90px 100px;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
    max-width: 980px;
    align-items: center;
    text-align: center;
  }

  .academy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #FF6363, #FF8282);
    color: white;
    padding: 8px 16px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    width: fit-content;
    box-shadow: 0 4px 15px rgba(255, 99, 99, 0.3);

    .academy-icon {
      font-size: 16px;
    }
  }

  .hero-text h1 {
    font-size: 71px;
    font-weight: 600;
    margin: 0;
    line-height: 1.1;
    background: linear-gradient(135deg, #212529, #FF6363);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    display: grid;
    gap: 10px;
    font-size: 20px;
    line-height: 30px;
    font-weight: 500;
    margin: 0;
    color: #555;
    padding: 0;
    width: min(100%, 780px);
    text-align: left;
    list-style: none;
  }

  .hero-description :global(li) {
    position: relative;
    padding: 12px 18px 12px 52px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 99, 99, 0.14);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(33, 37, 41, 0.06);
  }

  .hero-description :global(li::before) {
    content: "✓";
    position: absolute;
    top: 50%;
    left: 16px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: white;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, #FF6363, #FF8282);
    border-radius: 50%;
    box-shadow: 0 4px 10px rgba(255, 99, 99, 0.28);
    transform: translateY(-50%);
  }

  .academy-highlight {
    display: flex;
    align-items: center;
    gap: 15px;
    background: rgba(255, 99, 99, 0.1);
    padding: 20px;
    border-radius: 15px;
    border-left: 4px solid #FF6363;
    max-width: 760px;

    .academy-icon {
      font-size: 24px;
      animation: sparkle 3s ease-in-out infinite;
    }

    p {
      margin: 0;
      font-weight: 500;
      color: #FF6363;
    }
  }

  @keyframes sparkle {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-5px) rotate(5deg); }
  }

  .academy-cta {
    background: linear-gradient(135deg, #FF6363, #FF8282) !important;
    border: none !important;
    transform: scale(1.1);
    box-shadow: 0 8px 25px rgba(255, 99, 99, 0.3);
    transition: all 0.3s ease !important;
  }

  .academy-cta:hover {
    transform: scale(1.15) !important;
    box-shadow: 0 12px 35px rgba(255, 99, 99, 0.4) !important;
  }

  .academy-proof {
    background: rgba(255, 255, 255, 0.86);
    color: #FF6363;
    padding: 10px 15px;
    border-radius: 25px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid rgba(255, 99, 99, 0.18);
    box-shadow: 0 8px 24px rgba(255, 99, 99, 0.12);

    span {
      font-size: 16px;
    }

    p {
      margin: 0;
    }
  }

  @media screen and (max-width: 1600px) {
    .hero-content {
      padding: 80px 40px;
    }

    .hero-text {
      width: 100%;
      min-width: unset;

      h1 {
        font-size: 50px;
      }

      .hero-description {
        font-size: 18px;
        line-height: 28px;
      }
    }
  }

  @media screen and (max-width: 1300px) {
    .hero-content {
      min-height: 500px;
      padding: 70px 40px;
    }

    .hero-text {
      gap: 25px;

      h1 {
        font-size: 42px;
      }

      .hero-description {
        font-size: 17px;
        line-height: 26px;
      }
    }
  }

  @media screen and (max-width: 1000px) {
    .hero-content {
      padding: 60px 30px;
    }

    .hero-text {
      width: 100%;
      align-items: center;
      text-align: center;

      h1 {
        font-size: 36px;
        line-height: 1.1;
      }

      .hero-description {
        font-size: 16px;
        line-height: 24px;
      }
    }

    .academy-highlight {
      flex-direction: column;
      text-align: center;
      padding: 15px;
    }

  }

  @media screen and (max-width: 768px) {
    .hero-content {
      padding: 40px 20px;
    }

    .hero-text h1 {
      font-size: 28px;
    }

    .hero-description {
      font-size: 14px;
      line-height: 22px;
    }

    .hero-description :global(li) {
      padding: 10px 14px 10px 44px;
      border-radius: 12px;
    }

    .hero-description :global(li::before) {
      left: 13px;
      width: 22px;
      height: 22px;
      font-size: 12px;
    }

    .academy-highlight {
      padding: 12px;
    }

    .academy-proof {
      padding: 8px 12px;
      
      span {
        font-size: 14px;
      }
      
      p {
        font-size: 12px;
      }
    }
  }
</style>
